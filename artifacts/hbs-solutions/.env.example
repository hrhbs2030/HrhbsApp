# الواجهة — أسماء المتغيرات فقط. القيم تُضبط في بيئة البناء أو مدير الأسرار ولا تُرفع إلى Git.
# المتغيرات التي تبدأ بـ VITE_ تُضمَّن في حزمة المتصفح؛ لا تضع فيها أي سر.

# ---- مطلوبة للبناء والتشغيل ----
PORT=                                  # منفذ خادم التطوير وserver.mjs
BASE_PATH=                             # المسار الأساسي للموقع (عادة /)

# ---- اختيارية ----
SITE_URL=                              # أصل الموقع وقت البناء (الافتراضي https://hrhbs.com)
VITE_SITE_URL=                         # يُعرَّف تلقائيًا من SITE_URL أثناء البناء؛ لا يُضبط يدويًا
VITE_CLERK_PUBLISHABLE_KEY=            # مفتاح Clerk العام للبوابة
VITE_CLERK_PROXY_URL=                  # عنوان وكيل Clerk (/api/__clerk)
NODE_ENV=                              # production في الإنتاج؛ إضافات Replit تعمل خارجه فقط
REPL_ID=                               # تضبطه Replit؛ يفعّل إضافات التطوير مع NODE_ENV غير الإنتاج

# ---- للاختبارات فقط ----
CHROMIUM_PATH=                         # مسار متصفح لفحص التباين المصيّر
