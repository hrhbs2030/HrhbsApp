{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "test": "node ../../scripts/run-tests.mjs api",
    "test:db-guards": "node --test ../../scripts/db-command-guards.test.mjs ../../scripts/db-physical-identity.test.mjs",
    "test:db": "node ../../scripts/run-tests.mjs api-db",
    "test:billing-integrity": "HBS_OFFICE_EMAIL=billing-integrity-office@example.invalid node ../../scripts/run-db-test.mjs tests/billing-payment-integrity.test.ts",
    "test:portal-isolation": "node ../../scripts/run-db-test.mjs tests/portal-inquiry-isolation.test.ts",
    "test:service-requests": "node ../../scripts/run-db-test.mjs tests/service-request-regressions.test.ts",
    "test:attachment-cleanup": "node ../../scripts/run-db-test.mjs tests/expired-request-attachments.test.ts",
    "test:attachment-access": "HBS_OFFICE_EMAIL=attachment-access-office@example.invalid node ../../scripts/run-db-test.mjs tests/request-attachment-access.test.ts",
    "test:attachment-lifecycle": "HBS_OFFICE_EMAIL=attachment-lifecycle-office@example.invalid node ../../scripts/run-db-test.mjs tests/request-attachment-lifecycle.test.ts",
    "test:attachment-storage": "HBS_OFFICE_EMAIL=attachment-storage-office@example.invalid node ../../scripts/run-db-test.mjs tests/request-attachment-storage.test.ts",
    "test:assistant-retrieval": "tsx --test tests/assistant-retrieval.test.ts",
    "test:notifications": "tsx --test tests/notifications.test.ts tests/notification-hardening.test.ts",
    "test:brand": "tsx --test tests/brand.test.ts",
    "test:notification-intelligence": "tsx --test tests/notification-intelligence.test.ts",
    "test:notification-pipeline": "HBS_OFFICE_EMAIL=notification-pipeline-owner@example.invalid node ../../scripts/run-db-test.mjs tests/notification-pipeline.test.ts",
    "test:assistant-citations": "node ../../scripts/run-db-test.mjs tests/assistant-citations.test.ts",
    "test:approved-information-history": "HBS_OFFICE_EMAIL=history-test-office@example.invalid node ../../scripts/run-db-test.mjs tests/approved-information-history.test.ts",
    "test:api-security": "tsx --test tests/openai-security.test.ts tests/api-hardening.test.ts",
    "test:office-access": "tsx --test tests/office-access.test.ts tests/office-helpers.test.ts",
    "test:openai-auth": "tsx --test tests/openai-auth.test.ts",
    "test:office-admin": "node ../../scripts/run-db-test.mjs tests/office-admin.test.ts",
    "test:office-staff-management": "HBS_OFFICE_EMAIL=office-staff-test-owner@example.invalid node ../../scripts/run-db-test.mjs tests/office-staff-management.test.ts",
    "test:office-revocation": "HBS_OFFICE_EMAIL=revocation-test-owner@example.invalid node ../../scripts/run-db-test.mjs tests/office-revocation-routes.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:office-features": "HBS_OFFICE_EMAIL=office-features-owner@example.invalid node ../../scripts/run-db-test.mjs tests/office-features.test.ts",
    "test:office-features-units": "tsx --test tests/office-features-units.test.ts",
    "test:company-file": "HBS_OFFICE_EMAIL=company-file-owner@example.invalid node ../../scripts/run-db-test.mjs tests/company-file.test.ts",
    "test:automations": "HBS_OFFICE_EMAIL=automation-owner@example.invalid node ../../scripts/run-db-test.mjs tests/automations.test.ts",
    "test:package-c": "HBS_OFFICE_EMAIL=package-c-owner@example.invalid node ../../scripts/run-db-test.mjs tests/package-c.test.ts",
    "test:package-d-subscriptions": "HBS_OFFICE_EMAIL=package-d-owner@example.invalid node ../../scripts/run-db-test.mjs tests/package-d-subscriptions.test.ts",
    "test:whatsapp-inbound": "tsx --test tests/whatsapp-inbound.test.ts",
    "test:package-d-members": "HBS_OFFICE_EMAIL=package-d-members-office@example.invalid node ../../scripts/run-db-test.mjs tests/package-d-members.test.ts",
    "test:notifications-api": "HBS_OFFICE_EMAIL=notifications-api-office@example.invalid node ../../scripts/run-db-test.mjs tests/notifications-api.test.ts",
    "test:messaging": "HBS_OFFICE_EMAIL=messaging-office@example.invalid node ../../scripts/run-db-test.mjs tests/messaging.test.ts",
    "test:notifications-stream": "node ../../scripts/run-db-test.mjs tests/notifications-stream.test.ts"
  },
  "dependencies": {
    "@clerk/express": "^2.1.72",
    "@clerk/shared": "^4.36.0",
    "@google-cloud/storage": "^8.2.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/integrations-anthropic-ai": "workspace:*",
    "@workspace/integrations-openai-ai-server": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "google-auth-library": "^11.1.0",
    "http-proxy-middleware": "^4.2.0",
    "nodemailer": "^10.0.12",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "web-push": "^3.6.7",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/nodemailer": "^8.0.2",
    "@types/web-push": "^3.6.4",
    "esbuild": "0.28.2",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0",
    "tsx": "catalog:"
  }
}
