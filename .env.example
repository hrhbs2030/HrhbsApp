# انظر الملفين المفصّلين: artifacts/api-server/.env.example و artifacts/hbs-solutions/.env.example (أسماء فقط، بلا قيم).

# --- الخادم (artifacts/api-server) ---
# خادم API — أسماء المتغيرات فقط. القيم تُضبط في مدير الأسرار لدى المستضيف ولا تُرفع إلى Git.
# الجدول الكامل بالمعاني في README.md (قسم «متغيرات البيئة») ودليل التشغيل docs/RUNBOOK.md.
# ---- مطلوبة: يفشل الخادم أو تسقط صلاحية المكتب دونها ----
PORT=                                  # منفذ الاستماع
DATABASE_URL=                          # اتصال PostgreSQL للتطبيق والترحيلات
CLERK_SECRET_KEY=                      # مفتاح Clerk السري (الجلسات ووكيل /api/__clerk)
CLERK_PUBLISHABLE_KEY=                 # مفتاح Clerk العام الذي يستخدمه الخادم
HBS_OFFICE_EMAIL=                      # بريد مالك المكتب المعتمد
# ---- التشغيل العام ----
NODE_ENV=                              # production في الإنتاج
LOG_LEVEL=                             # مستوى سجلات pino (الافتراضي info)
CORS_ALLOWED_ORIGINS=                  # أصول إضافية مسموح بها، مفصولة بفواصل
REPLIT_DOMAINS=                        # تضبطها Replit؛ تُضاف إلى CORS تلقائيًا
REPLIT_DEV_DOMAIN=                     # تضبطها Replit؛ أصل التطوير خارج الإنتاج
PUBLIC_SITE_URL=                       # أصل الموقع في روابط البريد والإشعارات وصفحات الدفع
# ---- البريد (معطل دون SMTP_HOST وSMTP_USER وSMTP_PASS) ----
SMTP_HOST=
SMTP_PORT=                             # 465 ضمني، 587 STARTTLS
SMTP_USER=
SMTP_PASS=
MAIL_FROM=                             # عنوان المرسل الظاهر
HBS_NOTIFY_EMAIL=                      # صندوق المكتب للإشعارات (الافتراضي HBS_OFFICE_EMAIL)
# ---- الدفع الفوري للمتصفح (معطل دون الثلاثة؛ تُولَّد بـ npx web-push generate-vapid-keys) ----
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=                         # mailto: أو https: يعرّف المرسل
# ---- واتساب Business Cloud API (الإرسال معطل دون الثلاثة الأولى) ----
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=                # قالب معتمد من Meta بمتغير واحد للنص
WHATSAPP_TEMPLATE_LANGUAGE=            # الافتراضي ar
WHATSAPP_GRAPH_VERSION=                # الافتراضي v21.0
WHATSAPP_VERIFY_TOKEN=                 # رمز تسجيل الـWebhook في لوحة Meta
WHATSAPP_APP_SECRET=                   # توقيع التسليمات الواردة؛ توثيق الأرقام معطل دونه
OFFICE_WHATSAPP_NUMBER=                # رقم المكتب الذي يراسله العملاء (أرقام فقط بالصيغة الدولية)
# ---- السداد الإلكتروني عبر ميسّر (معطل دون المفتاح) ----
MOYASAR_SECRET_KEY=
MOYASAR_WEBHOOK_SECRET=                # توقيع إشعارات ميسّر
HBS_LEGAL_NAME=                        # اسم البائع على الفواتير
HBS_VAT_NUMBER=                        # الرقم الضريبي على الفواتير
# ---- تكاملات خارجية ----
WATHQ_API_KEY=                         # استعلام السجل التجاري؛ المسار يجيب 503 دونه
AI_INTEGRATIONS_OPENAI_API_KEY=        # استخراج بيانات المستندات
AI_INTEGRATIONS_OPENAI_BASE_URL=
AI_INTEGRATIONS_ANTHROPIC_API_KEY=     # المساعد «أم مشعل»
AI_INTEGRATIONS_ANTHROPIC_BASE_URL=
# ---- التخزين (Replit App Storage) ----
PRIVATE_OBJECT_DIR=                    # مجلد التخزين الخاص لمرفقات الطلبات
PUBLIC_OBJECT_SEARCH_PATHS=            # مسارات التخزين العام المسموح بقراءتها
# ---- للاختبارات فقط (لا تُضبط في الإنتاج) ----
TEST_DATABASE_URL=                     # قاعدة اختبار مرحّلة مختلفة عن DATABASE_URL
TEST_PRIVATE_OBJECT_DIR=               # مجلد تخزين للاختبار يفعّل فحص التخزين الحقيقي
HBS_TEST_DB_IDENTITY=                  # تضبطه سكربتات الاختبار تلقائيًا (هوية قاعدة الاختبار)

# --- الواجهة (artifacts/hbs-solutions) ---
# الواجهة — أسماء المتغيرات فقط. القيم تُضبط في بيئة البناء أو مدير الأسرار ولا تُرفع إلى Git.
# المتغيرات التي تبدأ بـ VITE_ تُضمَّن في حزمة المتصفح؛ لا تضع فيها أي سر.
# ---- مطلوبة للبناء والتشغيل ----
PORT=                                  # منفذ خادم التطوير وserver.mjs
BASE_PATH=                             # المسار الأساسي للموقع (عادة /)
# ---- اختيارية ----
SITE_URL=                              # أصل الموقع وقت البناء (الافتراضي https://hrhbs.com)
VITE_SITE_URL=                         # يُعرَّف تلقائيًا من SITE_URL أثناء البناء؛ لا يُضبط يدويًا
VITE_CLERK_PUBLISHABLE_KEY=            # مفتاح Clerk العام للبوابة
VITE_CLERK_PROXY_URL=                  # عنوان وكيل Clerk (/api/__clerk)
NODE_ENV=                              # production في الإنتاج؛ إضافات Replit تعمل خارجه فقط
REPL_ID=                               # تضبطه Replit؛ يفعّل إضافات التطوير مع NODE_ENV غير الإنتاج
# ---- للاختبارات فقط ----
CHROMIUM_PATH=                         # مسار متصفح لفحص التباين المصيّر
