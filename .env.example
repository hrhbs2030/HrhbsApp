# Values are intentionally blank. Configure them in your host's secret manager.
DATABASE_URL=
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
VITE_CLERK_PUBLISHABLE_KEY=
VITE_CLERK_PROXY_URL=
HBS_OFFICE_EMAIL=
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=
AI_INTEGRATIONS_ANTHROPIC_API_KEY=
AI_INTEGRATIONS_ANTHROPIC_BASE_URL=
PORT=
BASE_PATH=
# Optional: email notifications (see artifacts/api-server/src/lib/notify.ts)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
HBS_NOTIFY_EMAIL=
PUBLIC_SITE_URL=
# Optional: WhatsApp Business Cloud API (approved template with one body variable)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=
# Optional: inbound WhatsApp webhook (Meta app dashboard). The verify token is
# the value you type when registering the callback; the app secret signs each delivery.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Optional: online payment through Moyasar hosted invoices
MOYASAR_SECRET_KEY=
MOYASAR_WEBHOOK_SECRET=
# Seller details printed on invoices
HBS_LEGAL_NAME=
HBS_VAT_NUMBER=
# Optional: commercial register lookup through Wathq (api.wathq.sa); without it the lookup endpoints answer 503
WATHQ_API_KEY=
